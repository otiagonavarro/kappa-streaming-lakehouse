# Kafka / Redpanda
KAFKA_BROKERS=broker:9092

# Storage backend: "minio" (default, local) or "gcs" (cloud)
STORAGE_BACKEND=minio

# MinIO (local GCS proxy)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kappa-lake

# GCS (only used when STORAGE_BACKEND=gcs)
GCS_BUCKET=
GCS_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json

# Nessie REST catalog
NESSIE_URI=http://nessie:19120/api/v1

# PostgreSQL: the shop application's OLTP database (CDC source, not a serving layer)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kappa
POSTGRES_USER=kappa
POSTGRES_PASSWORD=kappa
POSTGRES_DSN=postgresql://kappa:kappa@postgres:5432/kappa

# Flink
FLINK_JOBMANAGER_HOST=jobmanager
# Container port; the Flink UI is published on host :8082 (host :8081 is the Schema Registry)
FLINK_JOBMANAGER_PORT=8081
FLINK_CHECKPOINT_INTERVAL_MS=30000

# Debezium replication user (created by the Flyway migration, used by Kafka Connect)
DEBEZIUM_USER=debezium
DEBEZIUM_PASSWORD=debezium

# Schema Registry (built into Redpanda) and topics
SCHEMA_REGISTRY_URL=http://broker:8081
CLICKSTREAM_TOPIC=clickstream.events

# Simulator: TIME_SCALE = real seconds per simulated day (order lifecycle speed).
# Any SimConfig field can be overridden as SIM_<FIELD>, e.g. SIM_CANCEL_RATE=0.05
TIME_SCALE=60
SIM_SESSIONS_PER_SECOND=2

# PII hashing key for the bronze layer (ADR-0015). Dev-only value: never reuse it.
PII_HMAC_KEY=dev-only-change-me
